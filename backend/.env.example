# ============================================================
#  后端环境变量模板
# ============================================================
#  用法：把本文件复制一份、改名为 .env，然后填入你自己的真实配置。
#         .env 已经被 .gitignore 排除，不会提交到仓库。
#
#   复制命令（PowerShell）：
#     Copy-Item .env.example .env
# ============================================================

# ---------- 应用 ----------
APP_NAME=高校实验室设备预约管理系统
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=yuyu
DB_PASSWORD=请填写你的数据库密码
DB_NAME=lab_booking_v2

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 建议为不同项目/环境使用不同的 db 号（0-15），避免缓存键冲突。
# 例如本项目 V2 用 1，如果 0 已被别的项目占用。
REDIS_DB=1
REDIS_PASSWORD=

# ---------- 认证 ----------
# 生产环境务必换成随机长字符串，生成方法：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为随机生成的密钥
# Token 有效期（分钟）。7 天 = 10080 分钟
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 滑动续期阈值：剩余有效期少于这个比例时，访问接口会自动续期
TOKEN_RENEW_THRESHOLD_RATIO=0.5

# ---------- 文件上传 ----------
# 单个文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=5
# 允许的图片类型
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ---------- CORS ----------
# 允许跨域访问的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 邮件（QQ 邮箱示例） ----------
# SMTP_PASSWORD 填的是邮箱「授权码」，不是邮箱登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_ENABLED=false
